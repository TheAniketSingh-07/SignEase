# ============================================================
# SignEase environment configuration
# Copy this file to  .env.local  and fill in the values.
# ============================================================

# --- Public URL of the app -----------------------------------
# Used to build the Google sign-in redirect address.
# Local:       http://localhost:3000
# Production:  https://your-domain.com   (must be https)
APP_URL=http://localhost:3000

# --- Google Sign-In (Google Cloud OAuth 2.0) ------------------
# Create these in Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application.
# Authorized redirect URI to add there (exactly):
#     <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: AI lecture summaries (smart fallback if unset) --
GEMINI_API_KEY=
OPENAI_API_KEY=
